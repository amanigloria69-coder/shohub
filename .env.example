# Copy this file to ".env" and fill in what you need. Never share or upload .env.

# Local Flask server (5000 is reserved in some Windows environments)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5050

# --- Email (needed so reset links reach real inboxes) ---
# Gmail example: turn on 2-Step Verification, then create an "App password"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=ShopHub <youraddress@gmail.com>

# --- Social sign-in (leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: public address of the site (used in emails). Default: the address you opened.
# SITE_URL=http://localhost:5000

# --- Stage 3 weather search (get a key from openweathermap.org) ---
OPENWEATHER_API_KEY=

# --- Optional persistent paths for hosting ---
# Point both paths at writable persistent storage when deploying.
# DATABASE_PATH=/var/data/shop.db
# UPLOAD_DIR=/var/data/uploads
# COOKIE_SECURE=true

# --- Store details shown in the footer / contact page / emails (all optional) ---
# CONTACT_PHONE is also the WhatsApp number (icon + Live chat button), e.g. +250788123456
CONTACT_PHONE=
CONTACT_EMAIL=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
# Delivery fee in RWF added at checkout (default 2000; use 0 for free delivery)
SHIPPING_FEE=2000

# Optional: seconds to wait for the mail server (default 30)
# MAIL_TIMEOUT=30
